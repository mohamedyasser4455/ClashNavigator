<Window x:Class="ClashNavigator.Views.ClashNavigatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ClashNavigator.Views"
        Title="Clash Navigator"
        Height="680" Width="1260"
        MinHeight="480" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="#F3F5F7">

    <Window.Resources>

        <SolidColorBrush x:Key="Primary" Color="#0F4C5C" />
        <SolidColorBrush x:Key="Accent" Color="#0FA3B1" />
        <SolidColorBrush x:Key="Line" Color="#D8DEE3" />
        <SolidColorBrush x:Key="Ink" Color="#1E2A30" />
        <SolidColorBrush x:Key="Muted" Color="#5C6B73" />
        <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />

        <views:ClashTextBrushConverter x:Key="ClashBrush" />

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Height" Value="28" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Every grid cell is centred so the table reads as one block instead of a ragged edge -->
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>

        <!-- Element ids are read and copied, so give them a monospaced face -->
        <Style x:Key="IdCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="FontFamily" Value="Consolas, Courier New" />
        </Style>

        <!-- Element names are the one place the full text matters, so the tooltip carries
             the Revit name, the model and what the report originally said -->
        <Style x:Key="ElementCellA" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="ToolTip" Value="{Binding ElementATip}" />
        </Style>

        <Style x:Key="ElementCellB" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="ToolTip" Value="{Binding ElementBTip}" />
        </Style>

        <!-- ===== the coloured status dropdown ===== -->

        <!-- Each entry in the open list carries its own colour, so picking a status is a
             colour choice rather than reading five similar words -->
        <Style x:Key="StatusItem" TargetType="ComboBoxItem">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Shell" Margin="3,2"
                                Background="{Binding Converter={StaticResource ClashBrush}, ConverterParameter=fill}"
                                Padding="10,5">
                            <TextBlock Text="{Binding}" HorizontalAlignment="Center"
                                       Foreground="{Binding Converter={StaticResource ClashBrush}, ConverterParameter=text}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A deliberately bare ComboBox template: the colour comes from the cell behind it,
             and the stock Windows chrome would paint its own grey gradient over that. -->
        <ControlTemplate x:Key="FlatCombo" TargetType="ComboBox">
            <Grid Background="Transparent">
                <ToggleButton Focusable="False" ClickMode="Press"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                  Margin="8,0,16,0"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  IsHitTestVisible="False" />

                <Path Data="M 0 0 L 3.5 4 L 7 0 Z"
                      Fill="{TemplateBinding Foreground}"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Margin="0,1,6,0" IsHitTestVisible="False" />

                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                       AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                    <Border Background="White" BorderBrush="#C8D2D7" BorderThickness="1"
                            MinWidth="{TemplateBinding ActualWidth}">
                        <ItemsPresenter />
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style x:Key="StatusCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground"
                    Value="{Binding Status, Converter={StaticResource ClashBrush}, ConverterParameter=text}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource StatusItem}" />
            <Setter Property="Template" Value="{StaticResource FlatCombo}" />
        </Style>

        <!-- Assigned to: a dropdown you can also type into. The list offers the usual disciplines
             and anything typed joins it, which keeps one owner from being spelled four ways. -->
        <Style x:Key="AssigneeCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="IsEditable" Value="True" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderBrush" Value="#E2E8EB" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- The whole Status cell is the colour swatch. It keeps its own style, without the
             selection trigger, so the colour survives on the selected row. -->
        <Style x:Key="StatusCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background"
                    Value="{Binding Status, Converter={StaticResource ClashBrush}, ConverterParameter=fill}" />
            <Setter Property="Foreground"
                    Value="{Binding Status, Converter={StaticResource ClashBrush}, ConverterParameter=text}" />
        </Style>

        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="6,2,0,2" />
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#E6F4F6" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="{StaticResource Primary}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Primary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="12,0,12,8" />
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" Background="{StaticResource Primary}" Padding="16,12">
            <StackPanel>
                <TextBlock Text="Clash Navigator" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Navigate a Navisworks clash report inside Revit"
                           Foreground="#A9D6DC" FontSize="12" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- report file: picking a file loads it straight away, so there is nothing else to press -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="12,12,12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Clash report (.xml)" Style="{StaticResource Label}" />
                <TextBox   Grid.Column="1" Text="{Binding ReportPath}" IsReadOnly="True"
                           Background="#FAFBFC" Foreground="{StaticResource Muted}" />
                <Button    Grid.Column="2" Content="Open report..." Style="{StaticResource PrimaryAction}"
                           Command="{Binding BrowseCommand}" />
            </Grid>
        </Border>

        <!-- filters -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Test" Style="{StaticResource Label}" />
                <ComboBox  Grid.Column="1" ItemsSource="{Binding TestOptions}" SelectedItem="{Binding SelectedTest}" />

                <TextBlock Grid.Column="2" Text="Status" Style="{StaticResource Label}" Margin="14,0,8,0" />
                <ComboBox  Grid.Column="3" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" />

                <TextBlock Grid.Column="4" Text="Search" Style="{StaticResource Label}" Margin="14,0,8,0" />
                <TextBox   Grid.Column="5" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox  Grid.Column="6" Content="Group duplicates" IsChecked="{Binding GroupDuplicates}"
                           VerticalAlignment="Center" Margin="16,0,0,0"
                           ToolTip="Collapse the list into one heading per pair of element types, with a count." />

                <TextBlock Grid.Column="7" Text="{Binding CountSummary}" Style="{StaticResource Label}"
                           Margin="16,0,0,0" FontWeight="SemiBold" Foreground="{StaticResource Primary}" />
            </Grid>
        </Border>

        <!-- the clash list -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding ClashesView}"
                      SelectedItem="{Binding SelectedClash}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EDF1F3"
                      RowHeight="30"
                      AlternatingRowBackground="#FAFCFC"
                      BorderThickness="0"
                      CanUserResizeRows="False"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizingWhenGrouping="True">

                <!-- Right-click is where a Windows user looks first. The menu sits on the grid,
                     not on the row, so it can reach the view model's commands; the row is
                     selected on right-click in the code-behind so the commands act on it. -->
                <DataGrid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                               RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Show clash" Command="{Binding ShowCommand}" />
                        <MenuItem Header="Isolate" Command="{Binding IsolateCommand}" />
                        <Separator />
                        <MenuItem Header="Apply status and assignee to all duplicates"
                                  Command="{Binding ApplyToDuplicatesCommand}" />
                        <Separator />
                        <MenuItem Header="Copy clash details" Command="{Binding CopyDetailsCommand}" />
                        <MenuItem Header="Copy element A id" Command="{Binding CopyIdACommand}" />
                        <MenuItem Header="Copy element B id" Command="{Binding CopyIdBCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnRowRightButtonDown" />
                    </Style>
                </DataGrid.RowStyle>

                <!-- Shown only while "Group duplicates" is on. Every heading is one pair of
                     element types with the number of clashes behind it, collapsed by default -
                     that is how 272 rows become the handful of real issues underneath them. -->
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <Expander IsExpanded="False" Background="#EEF4F6"
                                                      BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                                                      Padding="0,2">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Margin="2,3">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource Primary}"
                                                                   VerticalAlignment="Center" />
                                                        <Border Background="{StaticResource Primary}" CornerRadius="9"
                                                                Padding="8,1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ItemCount}" Foreground="White"
                                                                       FontSize="11" FontWeight="SemiBold" />
                                                        </Border>
                                                    </StackPanel>
                                                </Expander.Header>
                                                <ItemsPresenter />
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </DataGrid.GroupStyle>

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#ECF1F3" />
                        <Setter Property="Foreground" Value="{StaticResource Ink}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Height" Value="32" />
                        <Setter Property="Padding" Value="6,0" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="6,0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Style.Triggers>
                            <!-- A light tint rather than a solid fill, so the status swatch
                                 next to it is still readable on the selected row -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#CDEAEE" />
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="46"
                                        ElementStyle="{StaticResource Cell}" />
                    <DataGridTextColumn Header="Test" Binding="{Binding TestName}" Width="110"
                                        ElementStyle="{StaticResource Cell}" />
                    <DataGridTextColumn Header="Clash" Binding="{Binding Name}" Width="82"
                                        ElementStyle="{StaticResource Cell}" />

                    <!-- Editable: the coordinator marks a clash Reviewed or Approved as they go,
                         and Export report carries whatever they set here. -->
                    <DataGridTemplateColumn Header="Status" Width="118"
                                            CellStyle="{StaticResource StatusCell}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox Style="{StaticResource StatusCombo}"
                                          ItemsSource="{Binding DataContext.StatusValues,
                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          SelectedItem="{Binding Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="Change the clash status, then use Export report." />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Type" Binding="{Binding ClashType}" Width="80"
                                        ElementStyle="{StaticResource Cell}" />
                    <DataGridTextColumn Header="Distance (m)" Binding="{Binding Distance}" Width="92"
                                        ElementStyle="{StaticResource Cell}" />
                    <DataGridTextColumn Header="Grid / Level" Binding="{Binding GridLocation}" Width="124"
                                        ElementStyle="{StaticResource Cell}" />

                    <DataGridTextColumn Header="ID A" Binding="{Binding IdA}" Width="84"
                                        ElementStyle="{StaticResource IdCell}" />
                    <DataGridTextColumn Header="Element A" Binding="{Binding ElementA}" Width="*" MinWidth="150"
                                        ElementStyle="{StaticResource ElementCellA}" />

                    <DataGridTextColumn Header="ID B" Binding="{Binding IdB}" Width="84"
                                        ElementStyle="{StaticResource IdCell}" />
                    <DataGridTextColumn Header="Element B" Binding="{Binding ElementB}" Width="*" MinWidth="150"
                                        ElementStyle="{StaticResource ElementCellB}" />

                    <DataGridTemplateColumn Header="Assigned to" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox Style="{StaticResource AssigneeCombo}"
                                          ItemsSource="{Binding DataContext.AssigneeValues,
                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          Text="{Binding AssignedTo, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                          ToolTip="Who has to deal with this clash - pick one or type a new name." />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- options and actions -->
        <Border Grid.Row="4" Style="{StaticResource Card}">
            <StackPanel>

                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="Section box padding (m)" Style="{StaticResource Label}" Margin="0,2,8,2" />
                    <TextBox Width="60" Margin="0,2,0,2"
                             Text="{Binding PaddingMeters, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}" />

                    <CheckBox Content="Open clash on click" IsChecked="{Binding ShowOnSelect}"
                              VerticalAlignment="Center" Margin="20,2,0,2" />
                    <CheckBox Content="Isolate" IsChecked="{Binding IsolateOnShow}"
                              VerticalAlignment="Center" Margin="16,2,0,2" />
                </WrapPanel>

                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Copy details" Style="{StaticResource Action}" Command="{Binding CopyDetailsCommand}"
                            ToolTip="Copy the whole clash as text - ready to send to whoever has to fix it. The element ids on their own are on the right-click menu." />
                    <Button Content="Show clash" Style="{StaticResource PrimaryAction}" Command="{Binding ShowCommand}" />
                    <Button Content="Isolate" Style="{StaticResource Action}" Command="{Binding IsolateCommand}" />
                    <Button Content="Reset view" Style="{StaticResource Action}" Command="{Binding ResetViewCommand}" />
                    <Button Content="Export report" Style="{StaticResource Action}" Command="{Binding ExportCommand}"
                            ToolTip="Write the clash list, with the statuses you set, to a CSV file." />
                </WrapPanel>

            </StackPanel>
        </Border>

        <!-- status bar -->
        <Border Grid.Row="5" Background="#E7EDEF" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,6">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Ink}" FontSize="12"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}" />
        </Border>

    </Grid>
</Window>
